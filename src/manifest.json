{
  "manifest_version": 3,
  "name": "Auto Twish",
  "version": "0.3.6",
  "description": "Automatiza a pesca no Twish ($pescar no chat da Twitch), sincronizando com o cooldown real do site twish.com.br.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "*://*.twitch.tv/*",
    "*://twish.com.br/*",
    "*://*.twish.com.br/*"
  ],
  "background": {
    "scripts": [
      "shared.js",
      "background.js",
      "market.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "js": [
        "browser-polyfill.js",
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Twish"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "auto-twish@local.extension",
      "strict_min_version": "115.0"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
