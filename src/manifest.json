{
  "manifest_version": 3,
  "name": "Auto Twish",
  "version": "1.0.6",
  "description": "Automatiza a pesca no Twish ($pescar no chat da Twitch), sincronizando com o cooldown real do site twish.com.br.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "*://*.twitch.tv/*",
    "*://twish.com.br/*",
    "*://*.twish.com.br/*"
  ],
  "background": {
    "scripts": [
      "shared.js",
      "background.js",
      "market.js",
      "protection.js",
      "shop.js",
      "kit.js",
      "invdump.js",
      "board.js",
      "upgrade.js",
      "remedy.js",
      "chatter.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "js": [
        "browser-polyfill.js",
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Twish",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "auto-twish@local.extension",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
